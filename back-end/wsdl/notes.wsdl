<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                 xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                 xmlns:tns="http://scolarite.example.com/notes"
                 xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                 targetNamespace="http://scolarite.example.com/notes"
                 name="NotesService">

  <wsdl:types>
    <xsd:schema targetNamespace="http://scolarite.example.com/notes" elementFormDefault="qualified">

      <!-- Type de note -->
      <xsd:simpleType name="TypeNote">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="DS"/>
          <xsd:enumeration value="examen"/>
          <xsd:enumeration value="TP"/>
        </xsd:restriction>
      </xsd:simpleType>

      <!-- Mention -->
      <xsd:simpleType name="Mention">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="ajourne"/>
          <xsd:enumeration value="passable"/>
          <xsd:enumeration value="assez_bien"/>
          <xsd:enumeration value="bien"/>
          <xsd:enumeration value="tres_bien"/>
        </xsd:restriction>
      </xsd:simpleType>

      <!-- Statut -->
      <xsd:simpleType name="Statut">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="admis"/>
          <xsd:enumeration value="ajourne"/>
        </xsd:restriction>
      </xsd:simpleType>

      <!-- Note (avec infos étudiant / matière dénormalisées pour les vues) -->
      <xsd:complexType name="Note">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:string"/>
          <xsd:element name="etudiantId" type="xsd:string"/>
          <xsd:element name="matiereId" type="xsd:string"/>
          <xsd:element name="valeur" type="xsd:decimal"/>
          <xsd:element name="type" type="tns:TypeNote"/>
          <xsd:element name="etudiantNom" type="xsd:string"/>
          <xsd:element name="etudiantPrenom" type="xsd:string"/>
          <xsd:element name="matiereIntitule" type="xsd:string"/>
          <xsd:element name="coefficient" type="xsd:decimal"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- Bilan d'un étudiant (moyenne / mention / statut) -->
      <xsd:complexType name="Bilan">
        <xsd:sequence>
          <xsd:element name="etudiantId" type="xsd:string"/>
          <xsd:element name="etudiantNom" type="xsd:string"/>
          <xsd:element name="etudiantPrenom" type="xsd:string"/>
          <xsd:element name="classe" type="xsd:string"/>
          <xsd:element name="moyenne" type="xsd:decimal"/>
          <xsd:element name="mention" type="tns:Mention"/>
          <xsd:element name="statut" type="tns:Statut"/>
          <xsd:element name="nbMatieres" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- Liste de notes (wrapper nommé pour la sérialisation soap) -->
      <xsd:complexType name="ListeNotes">
        <xsd:sequence>
          <xsd:element name="note" type="tns:Note" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="ListeBilans">
        <xsd:sequence>
          <xsd:element name="bilan" type="tns:Bilan" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- ===== saisirNote (BF10, enseignant) ===== -->
      <xsd:element name="saisirNote">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="etudiantId" type="xsd:string"/>
            <xsd:element name="matiereId" type="xsd:string"/>
            <xsd:element name="valeur" type="xsd:decimal"/>
            <xsd:element name="type" type="tns:TypeNote"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="saisirNoteResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="note" type="tns:Note"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- ===== modifierNote (BF11, enseignant responsable ou admin) ===== -->
      <xsd:element name="modifierNote">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:string"/>
            <xsd:element name="valeur" type="xsd:decimal"/>
            <xsd:element name="type" type="tns:TypeNote" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="modifierNoteResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="note" type="tns:Note"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- ===== supprimerNote (enseignant responsable ou admin) ===== -->
      <xsd:element name="supprimerNote">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="supprimerNoteResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="succes" type="xsd:boolean"/>
            <xsd:element name="message" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- ===== consulterNotesEnseignant (BF12, enseignant) =====
           Filtre par matiereId (optionnel) et/ou etudiantId (optionnel).
           Limité aux matières de l'enseignant connecté. -->
      <xsd:element name="consulterNotesEnseignant">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="matiereId" type="xsd:string" minOccurs="0"/>
            <xsd:element name="etudiantId" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="consulterNotesEnseignantResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="notes" type="tns:ListeNotes"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- ===== consulterMoyennesClasse (BF13, enseignant) =====
           Renvoie le bilan (moyenne/mention/statut) de chaque étudiant
           dont au moins une note existe dans les matières de l'enseignant.
           Filtrable par classe. -->
      <xsd:element name="consulterMoyennesClasse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="classe" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="consulterMoyennesClasseResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="bilans" type="tns:ListeBilans"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- ===== consulterMesNotes (BF15, étudiant) ===== -->
      <xsd:element name="consulterMesNotes">
        <xsd:complexType>
          <xsd:sequence/>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="consulterMesNotesResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="notes" type="tns:ListeNotes"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <!-- ===== consulterMonBilan (BF16, BF17, BF18, étudiant) =====
           Renvoie la moyenne générale, la mention et le statut de l'étudiant
           connecté. -->
      <xsd:element name="consulterMonBilan">
        <xsd:complexType>
          <xsd:sequence/>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="consulterMonBilanResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="bilan" type="tns:Bilan"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </wsdl:types>

  <!-- Messages -->
  <wsdl:message name="saisirNoteRequestMessage">
    <wsdl:part name="parameters" element="tns:saisirNote"/>
  </wsdl:message>
  <wsdl:message name="saisirNoteResponseMessage">
    <wsdl:part name="parameters" element="tns:saisirNoteResponse"/>
  </wsdl:message>

  <wsdl:message name="modifierNoteRequestMessage">
    <wsdl:part name="parameters" element="tns:modifierNote"/>
  </wsdl:message>
  <wsdl:message name="modifierNoteResponseMessage">
    <wsdl:part name="parameters" element="tns:modifierNoteResponse"/>
  </wsdl:message>

  <wsdl:message name="supprimerNoteRequestMessage">
    <wsdl:part name="parameters" element="tns:supprimerNote"/>
  </wsdl:message>
  <wsdl:message name="supprimerNoteResponseMessage">
    <wsdl:part name="parameters" element="tns:supprimerNoteResponse"/>
  </wsdl:message>

  <wsdl:message name="consulterNotesEnseignantRequestMessage">
    <wsdl:part name="parameters" element="tns:consulterNotesEnseignant"/>
  </wsdl:message>
  <wsdl:message name="consulterNotesEnseignantResponseMessage">
    <wsdl:part name="parameters" element="tns:consulterNotesEnseignantResponse"/>
  </wsdl:message>

  <wsdl:message name="consulterMoyennesClasseRequestMessage">
    <wsdl:part name="parameters" element="tns:consulterMoyennesClasse"/>
  </wsdl:message>
  <wsdl:message name="consulterMoyennesClasseResponseMessage">
    <wsdl:part name="parameters" element="tns:consulterMoyennesClasseResponse"/>
  </wsdl:message>

  <wsdl:message name="consulterMesNotesRequestMessage">
    <wsdl:part name="parameters" element="tns:consulterMesNotes"/>
  </wsdl:message>
  <wsdl:message name="consulterMesNotesResponseMessage">
    <wsdl:part name="parameters" element="tns:consulterMesNotesResponse"/>
  </wsdl:message>

  <wsdl:message name="consulterMonBilanRequestMessage">
    <wsdl:part name="parameters" element="tns:consulterMonBilan"/>
  </wsdl:message>
  <wsdl:message name="consulterMonBilanResponseMessage">
    <wsdl:part name="parameters" element="tns:consulterMonBilanResponse"/>
  </wsdl:message>

  <wsdl:message name="NotesFaultMessage">
    <wsdl:part name="fault" type="xsd:string"/>
  </wsdl:message>

  <!-- Port Type -->
  <wsdl:portType name="NotesPortType">
    <wsdl:operation name="saisirNote">
      <wsdl:documentation>Saisit une note pour un étudiant sur une matière (enseignant responsable, BF10).</wsdl:documentation>
      <wsdl:input message="tns:saisirNoteRequestMessage"/>
      <wsdl:output message="tns:saisirNoteResponseMessage"/>
      <wsdl:fault name="NotesFault" message="tns:NotesFaultMessage"/>
    </wsdl:operation>
    <wsdl:operation name="modifierNote">
      <wsdl:documentation>Modifie la valeur / le type d'une note existante (enseignant responsable ou admin, BF11).</wsdl:documentation>
      <wsdl:input message="tns:modifierNoteRequestMessage"/>
      <wsdl:output message="tns:modifierNoteResponseMessage"/>
      <wsdl:fault name="NotesFault" message="tns:NotesFaultMessage"/>
    </wsdl:operation>
    <wsdl:operation name="supprimerNote">
      <wsdl:documentation>Supprime une note (enseignant responsable ou admin).</wsdl:documentation>
      <wsdl:input message="tns:supprimerNoteRequestMessage"/>
      <wsdl:output message="tns:supprimerNoteResponseMessage"/>
      <wsdl:fault name="NotesFault" message="tns:NotesFaultMessage"/>
    </wsdl:operation>
    <wsdl:operation name="consulterNotesEnseignant">
      <wsdl:documentation>Liste les notes des matières de l'enseignant connecté (BF12).</wsdl:documentation>
      <wsdl:input message="tns:consulterNotesEnseignantRequestMessage"/>
      <wsdl:output message="tns:consulterNotesEnseignantResponseMessage"/>
      <wsdl:fault name="NotesFault" message="tns:NotesFaultMessage"/>
    </wsdl:operation>
    <wsdl:operation name="consulterMoyennesClasse">
      <wsdl:documentation>Liste les bilans (moyenne/mention/statut) des étudiants concernés par les matières de l'enseignant (BF13).</wsdl:documentation>
      <wsdl:input message="tns:consulterMoyennesClasseRequestMessage"/>
      <wsdl:output message="tns:consulterMoyennesClasseResponseMessage"/>
      <wsdl:fault name="NotesFault" message="tns:NotesFaultMessage"/>
    </wsdl:operation>
    <wsdl:operation name="consulterMesNotes">
      <wsdl:documentation>L'étudiant consulte toutes ses notes (BF15).</wsdl:documentation>
      <wsdl:input message="tns:consulterMesNotesRequestMessage"/>
      <wsdl:output message="tns:consulterMesNotesResponseMessage"/>
      <wsdl:fault name="NotesFault" message="tns:NotesFaultMessage"/>
    </wsdl:operation>
    <wsdl:operation name="consulterMonBilan">
      <wsdl:documentation>L'étudiant consulte sa moyenne générale, sa mention et son statut (BF16, BF17, BF18).</wsdl:documentation>
      <wsdl:input message="tns:consulterMonBilanRequestMessage"/>
      <wsdl:output message="tns:consulterMonBilanResponseMessage"/>
      <wsdl:fault name="NotesFault" message="tns:NotesFaultMessage"/>
    </wsdl:operation>
  </wsdl:portType>

  <!-- Binding -->
  <wsdl:binding name="NotesBinding" type="tns:NotesPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

    <wsdl:operation name="saisirNote">
      <soap:operation soapAction="http://scolarite.example.com/notes/saisirNote"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotesFault"><soap:fault name="NotesFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="modifierNote">
      <soap:operation soapAction="http://scolarite.example.com/notes/modifierNote"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotesFault"><soap:fault name="NotesFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="supprimerNote">
      <soap:operation soapAction="http://scolarite.example.com/notes/supprimerNote"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotesFault"><soap:fault name="NotesFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="consulterNotesEnseignant">
      <soap:operation soapAction="http://scolarite.example.com/notes/consulterNotesEnseignant"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotesFault"><soap:fault name="NotesFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="consulterMoyennesClasse">
      <soap:operation soapAction="http://scolarite.example.com/notes/consulterMoyennesClasse"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotesFault"><soap:fault name="NotesFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="consulterMesNotes">
      <soap:operation soapAction="http://scolarite.example.com/notes/consulterMesNotes"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotesFault"><soap:fault name="NotesFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="consulterMonBilan">
      <soap:operation soapAction="http://scolarite.example.com/notes/consulterMonBilan"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotesFault"><soap:fault name="NotesFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
  </wsdl:binding>

  <!-- Service -->
  <wsdl:service name="NotesService">
    <wsdl:port name="NotesPort" binding="tns:NotesBinding">
      <soap:address location="http://localhost:3001/wsdl/notes"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>
